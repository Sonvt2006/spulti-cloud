# Copy to .env and fill in your RDS details. Do not commit .env.
# URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://spulti_admin:<password>@<rds-endpoint>.rds.amazonaws.com:5432/spulti?sslmode=require

# Secret key for signing login JWTs, at least 32 characters.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<random-secret>
SPULTI_CHECKPOINT_BUCKET=TEN_BUCKET_CUA_BAN
AWS_REGION=REGION_CUA_BUCKET

MARKET_AWS_REGIONS=ap-southeast-1
MARKET_GCP_PROJECT_ID=spulti-cloud
MARKET_GCP_REGION=asia-southeast1
MARKET_GCP_ZONES=asia-southeast1-b

# Image/network allowlist; see INSTANCE_MANAGER.md. No cloud credentials here.
SPULTI_LAUNCH_CONFIG=[]
SPULTI_MAX_MACHINES_PER_USER=5

# Managed jobs / automatic recovery; see RECOVERY.md.
SPULTI_PUBLIC_API_URL=https://api.example.com
SPULTI_AGENT_RELEASE_URL=https://releases.example.com/node-agent.tar.gz
SPULTI_AGENT_RELEASE_SHA256=
SPULTI_HEARTBEAT_TIMEOUT_SECONDS=90
SPULTI_AGENT_BOOT_GRACE_SECONDS=600
SPULTI_RECOVERY_COOLDOWN_SECONDS=300
SPULTI_RECOVERY_MAX_PER_HOUR=5

SPULTI_LAUNCH_CONFIG='[{"provider":"AWS","region":"ap-southeast-1","zone":"ap-southeast-1a","image_id":"ami-04256a783b750a373","machine_types":["t3.micro","t3.small","t3.medium","t3.large","c5.large","m5.large"],"subnet_id":"subnet-0b1f44552bf10c0e2","security_group_ids":["sg-0a0048e08cfecf26b"]},{"provider":"GCP","region":"asia-southeast1","zone":"asia-southeast1-b","image_id":"projects/ubuntu-os-cloud/global/images/family/ubuntu-2204-lts","machine_types":["e2-micro","e2-small","e2-medium","e2-standard-2","e2-standard-4","e2-standard-8"],"project_id":"spulti-cloud","subnetwork":"projects/spulti-cloud/regions/asia-southeast1/subnetworks/spulti-test-subnet"}]'

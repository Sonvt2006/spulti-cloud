# Copy to .env.local. See README.local.md for generating JWT_SECRET.
JWT_SECRET=<random-secret>
LOCAL_HTTP_PORT=8080
AWS_DEFAULT_REGION=us-east-1
SPULTI_LAUNCH_CONFIG=[]
SPULTI_MAX_MACHINES_PER_USER=5
# AWS credentials are exported into the current shell; do not paste them here.
# DATABASE_URL is defined in compose.local.yaml and points to local PostgreSQL.
# Blank until enabling S3 checkpoints; opening the dashboard does not need S3.
SPULTI_CHECKPOINT_BUCKET=
AWS_REGION=us-east-1
# Match the regions/zones in SPULTI_LAUNCH_CONFIG before collecting market data.
MARKET_AWS_REGIONS=us-east-1
MARKET_GCP_PROJECT_ID=spulti-cloud
MARKET_GCP_REGION=asia-southeast1
MARKET_GCP_ZONES=asia-southeast1-b
# Blank = all catalog types. Catalog only the types you intend to use for GCP.
MARKET_LIMIT_TYPES=
# Managed jobs / automatic recovery; see RECOVERY.md.
SPULTI_PUBLIC_API_URL=
SPULTI_AGENT_RELEASE_URL=
SPULTI_AGENT_RELEASE_SHA256=
SPULTI_HEARTBEAT_TIMEOUT_SECONDS=90
SPULTI_AGENT_BOOT_GRACE_SECONDS=600
SPULTI_RECOVERY_COOLDOWN_SECONDS=300
SPULTI_RECOVERY_MAX_PER_HOUR=5

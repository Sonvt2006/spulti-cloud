# Copy to .env.local. See README.local.md for generating JWT_SECRET.
JWT_SECRET=WdfRapykvRckBFqkVKfi3Xhca/uSORrTdAqPWaDQ8tICNLKTE2JcL1iHqKT+bMDp
LOCAL_HTTP_PORT=8080
AWS_DEFAULT_REGION=ap-southeast-1
SPULTI_MAX_MACHINES_PER_USER=5
AWS_ACCESS_KEY_ID= YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY= YOUR_SECRET_ACCESS_KEY
# DATABASE_URL is defined in compose.local.yaml and points to local PostgreSQL.
# Shared private bucket: checkpoints/ + agent/releases/. See S3_SETUP.md.
# API needs read/write access to checkpoints/*; CloudFront reads agent/releases/* only.
# Blank until enabling S3 checkpoints; opening the dashboard does not need S3.
SPULTI_CHECKPOINT_BUCKET=
AWS_REGION=ap-southeast-1
# Match the regions/zones in SPULTI_LAUNCH_CONFIG before collecting market data.
MARKET_AWS_REGIONS=ap-southeast-1
MARKET_GCP_PROJECT_ID=spulti-cloud
MARKET_GCP_REGION=asia-southeast1
MARKET_GCP_ZONES=asia-southeast1-b
# Blank = all catalog types. Catalog only the types you intend to use for GCP.
MARKET_LIMIT_TYPES=
# Managed jobs / automatic recovery; see RECOVERY.md.
SPULTI_PUBLIC_API_URL=
# Durable HTTPS URL accessible from AWS/GCP VMs; see S3_SETUP.md.
SPULTI_AGENT_RELEASE_URL=
SPULTI_AGENT_RELEASE_SHA256=
SPULTI_HEARTBEAT_TIMEOUT_SECONDS=90
SPULTI_AGENT_BOOT_GRACE_SECONDS=600
SPULTI_RECOVERY_COOLDOWN_SECONDS=300
SPULTI_RECOVERY_MAX_PER_HOUR=5

SPULTI_LAUNCH_CONFIG='[{"provider":"AWS","region":"ap-southeast-1","zone":"ap-southeast-1a","image_id":"ami-04256a783b750a373","machine_types":["t3.small"],"subnet_id":"subnet-0b1f44552bf10c0e2","security_group_ids":["sg-0a0048e08cfecf26b"]},{"provider":"GCP","region":"asia-southeast1","zone":"asia-southeast1-b","image_id":"projects/ubuntu-os-cloud/global/images/family/ubuntu-2204-lts","machine_types":["e2-standard-4"],"project_id":"spulti-cloud","subnetwork":"projects/spulti-cloud/regions/asia-southeast1/subnetworks/spulti-test-subnet"}]'
